# ==============================================================================
# PayPilot Environment Configuration Template
# Copy this file to .env and configure values before starting the application
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=development
DEBUG=True

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# PostgreSQL connection string for production / staging:
# postgresql://username:password@localhost:5432/paypilot_db
# For lightweight local development without PostgreSQL, leave empty or use SQLite:
DATABASE_URL=sqlite:///./sql_app.db

# Official PayPal Sandbox REST API Configuration
# Get credentials from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here

# AI Provider Configuration (Google Gemini / Vertex AI)
# Get API key from https://aistudio.google.com/
# If AI_API_KEY is not provided, PayPilot automatically operates in labeled Demo Fallback mode.
AI_API_KEY=your_gemini_api_key_here
AI_MODEL_NAME=gemini-1.5-flash

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Public API URL
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
