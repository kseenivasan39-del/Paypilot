# ==========================================
# PayPilot Production Environment Configuration
# ==========================================

# Application Settings
ENVIRONMENT=production
DEBUG=False
APP_NAME=PayPilot API
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000

# Security (Generate a strong 64-char key in production, e.g. `openssl rand -hex 32`)
SECRET_KEY=replace-with-a-very-strong-production-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Production Database (PostgreSQL recommended for production)
# SQLite fallback: sqlite:///./sql_app.db
# PostgreSQL: postgresql://paypilot_user:strong_password@localhost:5432/paypilot_db
DATABASE_URL=sqlite:///./sql_app.db

# Official PayPal API Credentials
# Set to 'live' for real payments or 'sandbox' for test mode
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here

# AI Provider Configuration (Google Gemini)
AI_API_KEY=your_gemini_api_key_from_google_ai_studio
AI_MODEL_NAME=gemini-1.5-flash

# CORS Allowed Origins (Comma-separated list of production domain URLs)
CORS_ORIGINS=https://paypilot.yourdomain.com,http://localhost:3000

# Frontend Public Configuration (Build time variables)
NEXT_PUBLIC_API_URL=https://api.paypilot.yourdomain.com
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id_here
